# Copy this file to .env and fill your real keys

# Only required for the Azure TTS engine. Kokoro needs no credentials.
AZURE_TTS_KEY=your_azure_speech_key

AZURE_TTS_REGION=your_speech_region

AUDIBLE_EPUB3_MAKER_ENV=production

# Optional path overrides (these are the defaults inside the Docker image).
# VOICEBOX_INGEST_DIR=/ingest
# VOICEBOX_OUTPUT_DIR=/output
# VOICEBOX_CONFIG_DIR=/config
